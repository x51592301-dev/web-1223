{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-1223",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "225fa54e-1f45-4d0b-ba34-0a17c1e067f5","database_name": "web-app123" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "a4fb582ea1264b50a74580edb5b09120" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
